# The sources a production release is built from, each a repository and a full commit (git
# content, not a release asset, so neither repository has to tag first). The release workflow
# refuses a tag while a commit is empty or isn't 40 hex characters (build/release/guard.sh).
#
# sneakers-release: manifest/release.yaml at this commit pins k0s, helm and every image. The
# appliance's sign job countersigns it and each pinned image digest with the release key and
# publishes the signatures on the appliance's GitHub Release (docs/release.md).
SNEAKERS_RELEASE_REPO=Sneakers-PAM/sneakers-release
SNEAKERS_RELEASE_COMMIT=
# sneakers-web: apps/appliance-admin at this commit is built into the :8443 pages, which go into
# the root and ship as the Base Web unit.
SNEAKERS_WEB_REPO=Sneakers-PAM/sneakers-web
SNEAKERS_WEB_COMMIT=
# The oldest kit or init version that may verify a release (spec.kitMin, docs/kit.md). 0.0.0-0
# lets any verifier that reads the manifest format take it; raise it only when a release needs a
# newer verifier.
KIT_MIN=0.0.0-0
