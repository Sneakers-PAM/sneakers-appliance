# The sneakers-release version a production release is built for (its release.yaml and its
# signature). Empty until the owner pins it; the release workflow refuses a tag while it's empty.
SNEAKERS_RELEASE_VERSION=
# The oldest kit or init version that may verify a release (spec.kitMin, docs/kit.md). 0.0.0-0
# lets any verifier that reads the manifest format take it; raise it only when a release needs a
# newer verifier.
KIT_MIN=0.0.0-0
