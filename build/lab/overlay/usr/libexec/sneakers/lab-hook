#
# lab-hook: LAB ONLY, for the image suite (test/image/k0s); see
# lab-hook.yaml. Inert unless /run/sneakers/esp/lab-hook exists. In normal
# operation it reports, on the serial line, that no k0s runs until a
# product bundle is installed, then waits for one (the suite installs it
# through the Updates API) and checks k0s, the hello stack and the edge.
set -u
[ -e /run/sneakers/esp/lab-hook ] || exit 0
# The console services own the consoles and send other services' output to
# /run/sneakers/console.log; the suite reads the serial line, so write there.
if [ -c /dev/ttyS0 ]; then exec >/dev/ttyS0 2>&1; fi
say() { echo "lab-hook: $*"; }
product=/var/lib/sneakers/product/current

k() { "$product/k0s" kubectl "$@"; }
# wait_for <what> <command...>: retry every 10 seconds, for up to 40
# minutes. busybox's sh here has no arithmetic: count with characters.
wait_for() {
  what="$1"; shift
  i=""
  until "$@" >/dev/null 2>&1; do
    i="$i."
    # After three minutes, show once what the cluster is doing.
    if [ "${#i}" -eq 18 ] && [ -x "$product/k0s" ]; then
      say "still waiting for $what"
      k get pods -A -o wide
      say "routes:"; ip -4 route show table all
      say "addresses:"; ip -4 addr
    fi
    if [ "${#i}" -ge 240 ]; then
      say "gave up waiting for $what"
      [ -x "$product/k0s" ] && k get pods -A -o wide
      exit 1
    fi
    sleep 10
  done
  say "$what"
}

# box_running <host> <port>: whether edgefall's loopback listener says
# the box runs (/_box/state). accessd says so only once the phase loop has
# brought every phase of the product up (docs/upgrades.md#the-phases).
box_running() {
  printf 'GET /_box/state HTTP/1.0\r\nHost: %s\r\n\r\n' "$1" | nc -w 5 "$1" "$2" 2>/dev/null | grep -q '"state":"running"'
}

# pg_in <database> <sql>: psql as postgres in the bundled PostgreSQL's
# pod, through the root's kubectl.
pg_in() { k -n sneakers exec sneakers-postgres-0 -c postgres -- psql -U postgres -d "$1" -qtAX -v ON_ERROR_STOP=1 -c "$2"; }
# pg_start: how the bundled PostgreSQL's current start began, from its
# log: first (a new data directory), clean (after a shutdown checkpoint)
# or recovered. The image's first start runs initdb's own server and stops
# it cleanly, so its init line comes first.
pg_start() {
  log="$(k -n sneakers logs sneakers-postgres-0 -c postgres 2>/dev/null)"
  case "$log" in
    *"init process complete"*) echo first ;;
    *"database system was interrupted"*|*"not properly shut down"*) echo recovered ;;
    *"database system was shut down"*) echo clean ;;
    "") echo unknown ;;
    *) echo first ;;
  esac
}

# The image suite's durability product (build/lab/durability.sh): the
# bundled PostgreSQL and a client on it. Once the box first runs it, 10000
# rows go into the database, once per box (the mark is on the state
# volume, so a lost database is never filled again). Each time the box
# runs a product version it hadn't reported since this boot (the install,
# the update, then after a reboot or a power loss), the hook prints the
# rows it counts and how the server's current start began: first (a new
# data directory), clean (after a shutdown checkpoint) or recovered.
durability_mark=/var/lib/sneakers/lab-durability-rows
pg() { pg_in durability "$1"; }
durability_report() {
  if [ ! -e "$durability_mark" ]; then
    if pg "CREATE TABLE durability_rows (id bigserial PRIMARY KEY, v text NOT NULL)" >/dev/null &&
      pg "INSERT INTO durability_rows (v) SELECT md5(g::text) FROM generate_series(1, 10000) g" >/dev/null; then
      : > "$durability_mark"
      sync
      say "durability: rows written"
    else
      say "durability: the rows couldn't be written"
    fi
  fi
  n="$(pg 'SELECT count(*) FROM durability_rows' 2>/dev/null)" || n=missing
  [ -n "$n" ] || n=missing
  start="$(pg_start)"
  [ "$start" != unknown ] || start=first
  say "durability: version=$1 rows=$n start=$start"
}
durability() {
  last=""
  while :; do
    v="$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$product/bundle.json")"
    if [ "$v" != "$last" ] && box_running 127.0.0.1 9180; then
      durability_report "$v"
      last="$v"
    fi
    sleep 5
  done
}

# The real-bundle job's product (build/realci): the Sneakers product
# itself, with its bundled PostgreSQL. Once the box first runs it, 1000
# rows go into a realci_rows table in each of the product's databases,
# once per box (the mark is on the state volume, so a lost database is
# never filled again). Each time the box runs a product version it hadn't
# reported since this boot, the hook prints, for the image test: the rows
# of every table in every database, how the server's current start began
# (pg_start), and the product's pods with their phase order, restarts,
# init containers (each one's restarts and how it ended or why it waits),
# why a container waits, and start and Ready times. While the box doesn't run, it prints the box's
# state, the pods, each wait-phase init container's last lines, each
# crash-looping container's last lines and the rows every five minutes, so
# a stuck update shows what holds it.
realci_dbs="sneakers_identity sneakers_vault sneakers_workflow sneakers_audit sneakers_kratos sneakers_hydra"
realci_mark=/var/lib/sneakers/lab-realci-rows
# Every table's rows, as <table>=<count>, comma-separated.
realci_count_sql="SELECT string_agg(c.relname || '=' || (xpath('/row/n/text()', query_to_xml(format('SELECT count(*) AS n FROM %I.%I', s.nspname, c.relname), false, true, '')))[1]::text, ',' ORDER BY c.relname) FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE c.relkind IN ('r', 'p') AND s.nspname NOT IN ('pg_catalog', 'information_schema') AND s.nspname NOT LIKE 'pg_toast%'"
realci_write() {
  ok=1
  for db in $realci_dbs; do
    if ! pg_in "$db" "CREATE TABLE realci_rows (id bigserial PRIMARY KEY, v text NOT NULL)" >/dev/null ||
      ! pg_in "$db" "INSERT INTO realci_rows (v) SELECT md5(g::text) FROM generate_series(1, 1000) g" >/dev/null; then
      ok=""
    fi
  done
  if [ -n "$ok" ]; then
    : > "$realci_mark"
    sync
    say "realci: rows written"
  else
    say "realci: the rows couldn't be written"
  fi
}
realci_rows() { # version when
  line=""
  for db in $realci_dbs; do
    n="$(pg_in "$db" "$realci_count_sql" 2>/dev/null)" || n=missing
    [ -n "$n" ] || n=empty
    line="$line $db[$n]"
  done
  say "realci: rows $2 version=$1 start=$(pg_start)$line"
}
realci_pods() { # version when
  say "realci: pods $2 version=$1: $(k -n sneakers get pods -o jsonpath='{range .items[*]}{.metadata.name} app={.metadata.labels.app\.kubernetes\.io/name} order={.metadata.labels.sneakers-appliance/phase-order} phase={.status.phase} restarts={.status.containerStatuses[*].restartCount} init=[{range .status.initContainerStatuses[*]}{.name}/{.restartCount}/{.state.terminated.reason}{.state.waiting.reason},{end}] waiting={.status.containerStatuses[*].state.waiting.reason} started={.status.startTime} ready={.status.conditions[?(@.type=="Ready")].status}@{.status.conditions[?(@.type=="Ready")].lastTransitionTime};{end}')"
}
# realci_waits: the last lines of each pod's wait-phase init container
# (the run before a restart, when there was one), so a phase stuck on its
# wait shows why.
realci_waits() {
  for p in $(k -n sneakers get pods -o jsonpath='{range .items[*]}{.metadata.name}{" "}{end}' 2>/dev/null); do
    l="$(k -n sneakers logs "$p" -c wait-phase --previous --tail=3 2>/dev/null)" || l=""
    [ -n "$l" ] || l="$(k -n sneakers logs "$p" -c wait-phase --tail=3 2>/dev/null)" || l=""
    [ -z "$l" ] || say "realci: wait-phase $p: $(printf '%s' "$l" | tr '\n' ' ')"
  done
}
# realci_crashes: the last lines of each crash-looping container's
# previous run, so a pod that won't stay up shows why.
realci_crashes() {
  k -n sneakers get pods -o jsonpath='{range .items[*]}{.metadata.name}{range .status.containerStatuses[?(@.state.waiting.reason=="CrashLoopBackOff")]}{" "}{.name}{end}{"\n"}{end}' 2>/dev/null |
    while read -r p c rest; do
      [ -n "$c" ] || continue
      say "realci: crash $p/$c: $(k -n sneakers logs "$p" -c "$c" --previous --tail=5 2>/dev/null | tr '\n' ' ')"
    done
}
box_state() {
  printf 'GET /_box/state HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n' | nc -w 5 127.0.0.1 9180 2>/dev/null | sed -n 's/.*"state":"\([^"]*\)".*/\1/p'
}
realci() {
  say "realci: the Sneakers product"
  last="" seen="" ticks=""
  while :; do
    v="$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$product/bundle.json")"
    if box_running 127.0.0.1 9180; then
      ticks=""
      # The box says running three times in a row before a report, so a
      # report never catches the moment between an apply and its gate.
      if [ "$v" != "$last" ]; then
        seen="$seen."
        if [ "${#seen}" -ge 3 ]; then
          [ -e "$realci_mark" ] || realci_write
          realci_rows "$v" running
          realci_pods "$v" running
          say "realci: report version=$v"
          last="$v" seen=""
        fi
      fi
    else
      seen=""
      ticks="$ticks."
      if [ "${#ticks}" -ge 60 ]; then
        say "realci: waiting version=$v state=$(box_state)"
        realci_pods "$v" waiting
        realci_waits
        realci_crashes
        realci_rows "$v" waiting
        ticks=""
      fi
    fi
    sleep 5
  done
}

# The kernel host name init set at boot: with no name configured and none
# from DHCP, the box's own, never "(none)".
say "host name $(uname -n)"
if [ ! -s "$product/bundle.json" ]; then
  if [ -e /var/lib/k0s/bin ]; then
    say "k0s ran without a product bundle"
  else
    say "no product bundle, no k0s"
  fi
fi
wait_for "product bundle installed" test -s "$product/bundle.json"
wait_for "api up" k get --raw /readyz
wait_for "node ready" k wait --for=condition=Ready node --all --timeout=10s
if [ -d "$product/manifests/durability" ]; then
  durability
fi
if [ -d "$product/manifests/sneakers" ]; then
  realci
fi
wait_for "hello pod ready" k -n sneakers-hello wait --for=condition=Ready pod -l app=hello --timeout=10s
# After a power loss the first Ready hello pod is the old one, restarted
# in place by the kubelet before the box quiesced it: sample the phases
# only once the box says running.
# The image suite may install a bundle without phases first: wait for one
# with them.
wait_for "phased product" grep -q '^phases:' "$product/product.yaml"
wait_for "box running" box_running 127.0.0.1 9180
# The lab product's phases (build/lab/product.yaml): each phased pod's
# restarts, when it started and when it got Ready, for the suite to check
# the order and that nothing restarted, and the scaling the box did (its
# quiesce, then each phase), for the log.
say "phase pods: $(k get pods -A -l sneakers-appliance/phase -o jsonpath='{range .items[*]}{.metadata.labels.app} restarts={.status.containerStatuses[0].restartCount} started={.status.startTime} ready={.status.conditions[?(@.type=="Ready")].lastTransitionTime};{end}')"
say "scaling events: $(k get events -n sneakers-hello --field-selector reason=ScalingReplicaSet --sort-by=.lastTimestamp -o jsonpath='{range .items[*]}{.lastTimestamp} {.message};{end}')"
# Every FailedCreatePodSandBox event's message, for the suite to check no
# pod's network was set up twice at once after a power loss.
say "sandbox events: $(k get events -A --field-selector reason=FailedCreatePodSandBox -o jsonpath='{range .items[*]}{.message};{end}')"
wait_for "edge pod ready" k -n sneakers-edge wait --for=condition=Ready pod -l app=edge --timeout=10s
k get nodes -o wide
k get pods -A -o wide
# The root shell's kubectl and helm: the root's links into the product
# slot, with the KUBECONFIG the root shell sets (internal/elevated).
export KUBECONFIG=/var/lib/k0s/pki/admin.conf HELM_CACHE_HOME=/tmp/helm/cache HELM_CONFIG_HOME=/tmp/helm/config HELM_DATA_HOME=/tmp/helm/data
if /usr/bin/kubectl get nodes; then say "root shell kubectl works"; else say "root shell kubectl failed"; fi
if /usr/bin/helm list -A; then say "root shell helm works"; else say "root shell helm failed"; fi
if /usr/bin/watch --version && [ -f /usr/share/terminfo/x/xterm ] && [ -f /usr/share/terminfo/p/putty ]; then say "root shell watch works"; else say "root shell watch failed"; fi

# The image suite's product reset (test/image/k0s, docs/upgrades.md
# "Removing the product"): the lab database's marker under the product's
# data root; once `sneakers reset` has taken the product away, what's left
# of it; and once it's installed again, the new marker. Without a reset it
# waits here quietly.
data=/var/lib/sneakers-data
say "product data: $(cat "$data/lab-db/written" 2>/dev/null || echo none)"
# A reinstall of the same version (`sneakers reinstall`) moves current to
# the other slot and keeps the data: once the box runs again from it, the
# marker and the phased pods' restarts.
slot="$(cd -P "$product" 2>/dev/null && pwd)"
while [ -e "$product/bundle.json" ]; do
  now="$(cd -P "$product" 2>/dev/null && pwd)"
  if [ -n "$now" ] && [ "$now" != "$slot" ] && box_running 127.0.0.1 9180; then
    slot="$now"
    say "after the reinstall of the same version: product data: $(cat "$data/lab-db/written" 2>/dev/null || echo none) restarts: $(k get pods -A -l sneakers-appliance/phase -o jsonpath='{range .items[*]}{.status.containerStatuses[0].restartCount}{" "}{end}')"
  fi
  sleep 5
done
staged="$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' /var/lib/sneakers/product/staged/bundle.json 2>/dev/null)"
links=""
for l in /var/lib/k0s/images/*.tar; do
  if [ -L "$l" ]; then links="$links."; fi
done
say "product reset: data [$(ls -A "$data" 2>/dev/null | tr '\n' ' ')] staged ${staged:-none} image links ${#links} stacks [$(ls /var/lib/k0s/manifests 2>/dev/null | tr '\n' ' ')]"
until [ -s "$product/bundle.json" ] && box_running 127.0.0.1 9180; do sleep 10; done
say "after the reinstall: product data: $(cat "$data/lab-db/written" 2>/dev/null || echo none)"
# A reinstall of the same version in the same run of the box's services,
# right after that install: once the box runs again from the other slot,
# every phase came back, with the data.
slot="$(cd -P "$product" 2>/dev/null && pwd)"
while :; do
  now="$(cd -P "$product" 2>/dev/null && pwd)"
  if [ -n "$now" ] && [ "$now" != "$slot" ] && box_running 127.0.0.1 9180; then
    say "after the reinstall after the reset: product data: $(cat "$data/lab-db/written" 2>/dev/null || echo none) phased pods ready: $(k get pods -A -l sneakers-appliance/phase -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{" "}{end}')"
    break
  fi
  sleep 5
done
