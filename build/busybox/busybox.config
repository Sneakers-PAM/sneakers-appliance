# The busybox options turned on for the root image's elevation shell. The
# build starts from allnoconfig, so every option not listed here (every
# network daemon among them) stays off. ss isn't a busybox applet; netstat
# covers it.
CONFIG_STATIC=y
# The busybox applet itself, for --list.
CONFIG_BUSYBOX=y
CONFIG_LONG_OPTS=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_BASH_COMPAT=y
# The root shell's prompt uses the line editor's \h and \w
# (internal/elevated/prompt.go; os/k0s/busybox_test.go checks it against
# this list); scripts may use ash's $(( )).
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
# Applets run from the shell without symlinks in the root image.
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_BASENAME=y
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CP=y
CONFIG_CUT=y
CONFIG_DATE=y
CONFIG_DF=y
CONFIG_DIRNAME=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_HEAD=y
CONFIG_ID=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_READLINK=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SHA256SUM=y
CONFIG_SLEEP=y
CONFIG_SORT=y
CONFIG_STAT=y
CONFIG_TAIL=y
CONFIG_TEE=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TEST2=y
CONFIG_TOUCH=y
CONFIG_TR=y
CONFIG_TRUE=y
CONFIG_UNAME=y
CONFIG_UNIQ=y
CONFIG_WC=y
CONFIG_WHOAMI=y
CONFIG_AWK=y
CONFIG_FIND=y
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_SED=y
CONFIG_XARGS=y
CONFIG_HEXDUMP=y
CONFIG_LESS=y
CONFIG_VI=y
CONFIG_CLEAR=y
CONFIG_DMESG=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_FREE=y
CONFIG_KILL=y
CONFIG_PS=y
CONFIG_TOP=y
CONFIG_UPTIME=y
CONFIG_LSOF=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_FEATURE_IP_NEIGH=y
CONFIG_NETSTAT=y
CONFIG_PING=y
# Troubleshooting from the root shell: base64 (a Secret's data), hostname,
# which, nslookup, and nc with netcat 1.10's -z, -v and -w for a port check
# (NC_EXTRA has -z; no NC_SERVER, so nc never listens).
CONFIG_BASE64=y
CONFIG_HOSTNAME=y
CONFIG_WHICH=y
CONFIG_NSLOOKUP=y
CONFIG_NC=y
CONFIG_NC_110_COMPAT=y
CONFIG_NC_EXTRA=y
CONFIG_FEATURE_IPV6=y
# The everyday options of the tools above.
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_PS_WIDE=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_MTIME=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_SORT_BIG=y
CONFIG_FEATURE_NETSTAT_WIDE=y
CONFIG_FEATURE_NETSTAT_PRG=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_DF_FANCY=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_LESS_BRACKETS=y
CONFIG_FEATURE_MOUNT_FLAGS=y
