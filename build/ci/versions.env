# Pinned build-time versions. Read by CI and the build scripts; go.mod carries GO_VERSION.
GO_VERSION=1.26.6
# cosign, for the lab keys and signatures in CI (release binary, checked against its published SHA-256).
COSIGN_VERSION=v3.1.3
COSIGN_SHA256_LINUX_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71

# The kernel: the 6.12 LTS line, built from its stable git tag with
# CONFIG_MODULES=n; the tag's commit is checked so a moved tag fails the build.
KERNEL_VERSION=6.12.112
KERNEL_COMMIT=7aba70ab2e8d8ab3cd45abcaa15e1119a00dc42a

# Static tools for the initrd and the root, built in pinned containers
# (build/static/*.sh). cryptsetup's tarball is checked against kernel.org's
# published SHA-256.
CRYPTSETUP_VERSION=2.7.5
CRYPTSETUP_SHA256=d2be4395b8f503b0ebf4b2d81db90c35a97050a358ee21fe62a0dfb66e5d5522
ALPINE_BUILDER=alpine:3.21
E2FSPROGS_VERSION=1.47.1
GPTFDISK_VERSION=1.0.9
DEBIAN_BUILDER=debian:12-slim

# k0s for lab builds (build/lab/build.sh), the same pin as sneakers-release's
# manifest/release.yaml; a production build takes k0s from that release.yaml.
# The upstream release binary, checked against its SHA-256 here.
K0S_VERSION=v1.36.4+k0s.1
K0S_SHA256_AMD64=18c304d53cdd70095e99c6b859b269b4fef0bb84579d7e7185271a9135694a31
