# Pinned sources for the static OpenSSH and busybox builds. Each tarball's
# SHA-256 is checked before it's unpacked. OpenSSH's was checked against the
# release signature (the OpenSSH release key) when the pin was set.
OPENSSH_VERSION=10.5p1
OPENSSH_SHA256=d44d28a839ea9daf969cc69150fde59910b2b39361dad81a3bd6cbd19218db11
# OpenSSL 3.5 is the LTS line; only libcrypto is linked.
OPENSSL_VERSION=3.5.9
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
BUSYBOX_VERSION=1.38.0
BUSYBOX_SHA256=34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2
# The musl builder, pinned by its multi-arch index digest.
ALPINE_BUILDER=alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
