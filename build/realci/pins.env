# The sources of the real-bundle job's builds (build/realci/build.sh,
# docs/testing.md#the-real-bundle-job): the Sneakers product as the lab
# bundles .12 and .13 were built, and the base the boxes ran under them.
# Each is a full commit of this repository and of sneakers-release.
#
# The base the boxes run today (lab build n6) and the first phased product
# (.13) are from this commit.
OLD_BASE_COMMIT=b2c576433773286d26cde227f0d29d5fbefb350b
# .12, the last product without phases.
P12_APPLIANCE_COMMIT=433866c36f6c1696a1226f04ef3c3165f234d24f
P12_RELEASE_COMMIT=1363ae0ed7ae7ffc58651d64e9fc2a9d83f2f58f
# .13, the first product with phases.
P13_APPLIANCE_COMMIT=b2c576433773286d26cde227f0d29d5fbefb350b
P13_RELEASE_COMMIT=eb2d8314072fda48073370bb689d73e4431b6fdb
# rc.6, the last product on the old database cluster, for the move leg.
RC6_APPLIANCE_COMMIT=34345e758a5252573d1beee7699dc1adb12e8eea
RC6_RELEASE_COMMIT=788f8f6a5e0c68376ca83284e23237a167ec30ff
# The product under test ("next", the release's next product) is built
# from the commit under test with sneakers-release at this commit; empty
# takes sneakers-release's main at the time of the run.
NEXT_RELEASE_COMMIT=859ae050dc1f85821279b722dec878fc9672018c
# The control leg's base: the code from before the quiesce fixes (#365,
# #370), on which the update from a product without phases to one with
# them must fail.
CONTROL_COMMIT=b2c576433773286d26cde227f0d29d5fbefb350b
