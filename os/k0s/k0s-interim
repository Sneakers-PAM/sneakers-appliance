# k0s-interim prepare|run: k0s's pre-start hook and its launcher
# (os/rootfs/services.d/k0s.yaml). INTERIM: it stands in for
# sneakers-platformd (#99), which renders the config, owns the data
# directory and the node's address, and starts k0s; it does only what k0s
# can't start without on a read-only, systemd-free root. docs/k0s.md has
# the layout. busybox's sh here has no arithmetic: counters are strings.
#
# k0s itself, its images and its stacks come from the installed product
# bundle's current slot (internal/product), never from the base root; the
# service entry doesn't start without one (start-when).
set -eu
data=/var/lib/k0s
product=/var/lib/sneakers/product/current
# The node's name is the box's own name, which init makes once per box and
# keeps on the state volume (internal/boxname; a box that had a k0s node
# name keeps it), so it doesn't follow the host name netd sets and stays
# unique when more nodes join (spec 3, Section 2.12).
name_file=/var/lib/sneakers/box-name
# The API and node address on the sneakers0 dummy interface (spec 3): a
# DHCP change on a real interface never changes it, its certificates or
# etcd's peer address. RFC 2544 space, never routed.
node_ip=198.18.0.1
# spec.network.serviceCIDR in k0s.yaml.tmpl (os/k0s/config_test.go).
service_cidr=10.96.0.0/12 # scrub:allow=private-ip -- the k0s default
say() { echo "k0s-interim: $*"; }

# kubelet_resolv <host file> <out>: the kubelet's resolver file, which the
# pods with dnsPolicy Default get, CoreDNS among them. CoreDNS forwards
# what isn't the cluster's to the servers there and exits at start with
# none, and the box runs with no DNS server (spec 1). Then the file names
# the node address instead, where nothing serves DNS: cluster names still
# resolve and the rest fail.
kubelet_resolv() {
  if grep -q '^nameserver ' "$1" 2>/dev/null; then
    cp "$1" "$2.new"
  else
    { grep -v '^nameserver ' "$1" 2>/dev/null || :; echo "nameserver $node_ip"; } > "$2.new"
  fi
  mv "$2.new" "$2"
}

# exposed_rbac <slot> <stack dir>: the RBAC the appliance rendered for the
# values the bundle's product.yaml exposes (internal/productspec) as its
# own stack, so the appliance's service account may get exactly those
# Secrets. A bundle that exposes none leaves no stack; k0s deletes what a
# removed stack held.
exposed_rbac() {
  if [ -s "$1/exposed-rbac.yaml" ]; then
    mkdir -p "$2"
    cp "$1/exposed-rbac.yaml" "$2/exposed-rbac.yaml.new"
    mv "$2/exposed-rbac.yaml.new" "$2/exposed-rbac.yaml"
    say "the product's exposed values RBAC is in place"
  elif [ -d "$2" ]; then
    rm -rf "$2"
    say "the product exposes no values; their RBAC goes"
  fi
}

# switched_off <slot> <stack> <state file>: whether a switch the bundle
# declares gates the stack and is off (internal/productswitch): the state
# an admin set on :8443, else the default the slot records.
switched_off() {
  [ -s "$1/switch-stacks" ] || return 1
  while read -r sw st def; do
    [ "$st" = "$2" ] || continue
    v="$def"
    if [ -s "$3" ]; then
      while read -r name val; do
        if [ "$name" = "$sw" ]; then v="$val"; fi
      done < "$3"
    fi
    [ "$v" = off ] && return 0
    return 1
  done < "$1/switch-stacks"
  return 1
}

# place_stack <slot stack dir/> <stack dir> <slot box-values> <box values>
# <kernel host>: the stack's files, with each placeholder the bundle
# declares (product.yaml box_values) replaced by the box's own value: the
# one recorded at the last apply, host name change or (for the Base OS and
# Base Web versions) boot, else, for box.fqdn, the kernel's host name.
# internal/boxvalues does the same in Go for productswitch. The values are
# host names, addresses and versions ([A-Za-z0-9.:[]+_-]), so they need no
# quoting in sed; the placeholders' dots are escaped.
place_stack() {
  expr=""
  if [ -s "$3" ]; then
    while read -r ph vname; do
      v=""
      if [ -s "$4" ]; then
        while read -r n val; do
          if [ "$n" = "$vname" ]; then v="$val"; fi
        done < "$4"
      fi
      if [ -z "$v" ] && [ "$vname" = box.fqdn ]; then v="$5"; fi
      [ -n "$v" ] || continue
      expr="$expr;s/$(echo "$ph" | sed 's/[.]/\\./g')/$v/g"
    done < "$3"
  fi
  mkdir -p "$2"
  for f in "$1"*.yaml; do
    [ -f "$f" ] || continue
    if [ -n "$expr" ]; then
      sed "${expr#;}" "$f" > "$2/$(basename "$f")"
    else
      cp "$f" "$2/"
    fi
  done
}

# box_tls <crt> <key> <stack dir>: the box-tls Secret in sneakers-edge
# with the chain and key, and the Traefik dynamic config that makes them
# the default certificate (traefik-tls.yaml), which the edge mounts next to
# its routes and reloads live. internal/productedge renders the same.
box_tls() {
  mkdir -p "$3"
  umask 077
  {
    printf 'apiVersion: v1\nkind: Namespace\nmetadata:\n  name: sneakers-edge\n---\n'
    printf 'apiVersion: v1\nkind: Secret\nmetadata:\n  name: box-tls\n  namespace: sneakers-edge\ntype: kubernetes.io/tls\nstringData:\n'
    printf '  tls.crt: |\n'; sed 's/^/    /' "$1"
    printf '  tls.key: |\n'; sed 's/^/    /' "$2"
    printf '  traefik-tls.yaml: |\n'
    printf '    tls:\n      stores:\n        default:\n          defaultCertificate:\n'
    printf '            certFile: |\n'; sed 's/^/              /' "$1"
    printf '            keyFile: |\n'; sed 's/^/              /' "$2"
  } > "$3/box-tls.yaml.new"
  mv "$3/box-tls.yaml.new" "$3/box-tls.yaml"
  umask 022
}

prepare() {
  if [ ! -s "$product/bundle.json" ] || [ ! -x "$product/k0s" ]; then
    say "no product bundle is installed; k0s comes with it (Updates)"
    exit 1
  fi
  # cgroup v2 for containerd and the kubelet.
  if ! grep -q '^[^ ]* /sys/fs/cgroup cgroup2 ' /proc/mounts; then
    mount -t cgroup2 -o nosuid,nodev,noexec cgroup2 /sys/fs/cgroup
    say "mounted cgroup2 on /sys/fs/cgroup"
  fi

  if [ ! -s "$name_file" ]; then
    say "the box has no name of its own yet ($name_file); init makes it at boot"
    exit 1
  fi
  read -r name < "$name_file"
  say "node $name"
  # /etc/machine-id leads here.
  if [ ! -s /var/lib/sneakers/machine-id ]; then
    read -r uuid < /proc/sys/kernel/random/uuid
    echo "$uuid" | tr -d - > /var/lib/sneakers/machine-id.new
    mv /var/lib/sneakers/machine-id.new /var/lib/sneakers/machine-id
  fi

  if ! ip link show sneakers0 >/dev/null 2>&1; then
    ip link add sneakers0 type dummy
  fi
  ip link set sneakers0 up
  if ! ip -4 addr show dev sneakers0 | grep -q "inet $node_ip/"; then
    ip addr add "$node_ip/32" dev sneakers0
  fi
  # A ClusterIP is only rewritten by kube-proxy's DNAT after the kernel has
  # found a route for it; with none (a management network with no gateway)
  # connect() fails with "network is unreachable", and kube-router can't
  # reach the API through the kubernetes Service. Routing the Service range on sneakers0 keeps
  # the cluster off the management network's gateway, like its address.
  ip route replace "$service_cidr" dev sneakers0 src "$node_ip"

  mkdir -p /run/sneakers/k0s
  sed "s/@NODE_NAME@/$name/g" /etc/k0s/k0s.yaml.tmpl > /run/sneakers/k0s/k0s.yaml

  # The root's /etc/cni and /opt are links to these, where kube-router
  # installs the CNI config and plugins.
  mkdir -p /var/lib/cni-conf/net.d /var/lib/opt/cni/bin
  # /var/log leads here (pod logs).
  mkdir -p /var/lib/log
  # netd writes the host's resolver file; until it has, an empty one. The
  # kubelet gets its own, made from it.
  [ -e /run/sneakers/resolv.conf ] || : > /run/sneakers/resolv.conf
  kubelet_resolv /run/sneakers/resolv.conf /run/sneakers/k0s/resolv.conf
  say "the kubelet's resolver: $(grep '^nameserver ' /run/sneakers/k0s/resolv.conf | tr '\n' ' ')"

  # The airgap images: k0s imports every archive in $data/images when its
  # worker starts. Links into the current product slot, so the images
  # aren't copied; links an earlier bundle left are replaced.
  mkdir -p "$data/images"
  for l in "$data"/images/*.tar; do
    if [ -L "$l" ]; then rm -f "$l"; fi
  done
  # The shell's own cd -P, not readlink -f: the box's busybox has no
  # readlink -f (os/k0s/busybox_test.go).
  slot="$(cd -P "$product" && pwd)"
  n=""
  for f in "$slot"/images/*.tar; do
    [ -f "$f" ] || continue
    ln -s "$f" "$data/images/"
    n="$n."
  done
  say "linked ${#n} images from the product bundle $(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$product/bundle.json") into $data/images"

  # Stacks k0s applies on its own: each <slot>/manifests/<name>/ is copied
  # to $data/manifests/<name>/, replacing what an earlier bundle put there.
  for d in "$slot"/manifests/*/; do
    [ -d "$d" ] || continue
    stack="$(basename "$d")"
    rm -rf "$data/manifests/$stack"
    if switched_off "$slot" "$stack" /var/lib/sneakers/platform/switches; then
      say "stack $stack is off (its switch on :8443)"
      continue
    fi
    place_stack "$d" "$data/manifests/$stack" "$slot/box-values" /var/lib/sneakers/platform/box-values "$(cat /proc/sys/kernel/hostname)"
    say "stack $stack in place"
  done
  exposed_rbac "$slot" "$data/manifests/sneakers-appliance-exposed"

  # INTERIM, until Traefik comes with the platform (#102): the box-tls
  # Secret for the edge, refreshed on every start: the certificate assigned
  # to the Product (443) endpoint when there is one (internal/productedge,
  # which also writes this stack live when it's assigned), else the box's
  # own :8443 certificate (osadmin renews it). It stays on the encrypted
  # state volume, in k0s's manifests and etcd.
  tls=/var/lib/sneakers/osadmin
  assigned=/var/lib/sneakers/platform/tls
  if [ -s "$assigned/product.crt" ] && [ -s "$assigned/product.key" ]; then
    box_tls "$assigned/product.crt" "$assigned/product.key" "$data/manifests/box-tls"
    say "the certificate assigned to the product's edge is in place"
  elif [ -s "$tls/tls.crt" ] && [ -s "$tls/tls.key" ]; then
    box_tls "$tls/tls.crt" "$tls/tls.key" "$data/manifests/box-tls"
    say "the box's certificate is in place for the edge"
  fi
}

run() {
  read -r name < "$name_file"
  # k0s puts its own binaries first; the kubelet finds mount(8) in /bin.
  export PATH=/usr/sbin:/usr/bin:/sbin:/bin
  exec "$product/k0s" controller --enable-worker --no-taints \
    --config /run/sneakers/k0s/k0s.yaml --data-dir "$data" --profile sneakers \
    --disable-components konnectivity-server,metrics-server,update-prober,autopilot \
    --kubelet-extra-args="--hostname-override=$name --node-ip=$node_ip --resolv-conf=/run/sneakers/k0s/resolv.conf"
}

case "${1:-}" in
  prepare) prepare ;;
  run) run ;;
  *) echo "usage: k0s-interim prepare|run" >&2; exit 2 ;;
esac
